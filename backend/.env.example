# Port du serveur
PORT=5000

# URI de connexion MongoDB Atlas
# Remplace <user>, <password> et <cluster> par tes informations
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority

# Clé secrète pour signer les tokens JWT (mets une chaîne aléatoire)
JWT_SECRET=ma_cle_secrete_super_longue_et_aleatoire_123
